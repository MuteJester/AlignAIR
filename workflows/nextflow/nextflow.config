// AlignAIR Nextflow wrapper DRAFT config.
manifest {
    name        = "alignair-predict"
    description = "AlignAIR per-sample IG/TCR alignment (draft wrapper)"
    mainScript  = "main.nf"
}

// Run with the published container (alignair/alignair):
//   nextflow run main.nf -profile docker --model <bundle|catalog id> --samplesheet ../samplesheet.csv
// The image's ENTRYPOINT is `alignair`, and Nextflow does not override entrypoints by default, so
// the docker profile clears it for the task shell; `-u` lets the task write into the work dir.
profiles {
    docker     {
        docker.enabled    = true
        docker.runOptions = '--entrypoint "" -u $(id -u):$(id -g)'
    }
    singularity { singularity.enabled = true }
    local      { process.container = null }   // use a local `alignair` already on PATH
}

process {
    cpus = 4
    memory = "8 GB"
}
